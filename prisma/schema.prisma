generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
 id          String   @id @default(uuid())
  name        String?
  email       String   @unique
  password    String?  // Optional, as Google auth won't require a password
  profilePic  String?  // Optional, to store the URL of the user's profile picture
  createdAt   DateTime @default(now())
}